# Get a key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Get a key at https://developers.faceit.com/
FACEIT_API_KEY=

# Get a key at https://leetify.com/app/developer (optional — higher rate limits)
LEETIFY_API_KEY=

# Redis for analyze job queue (required for demo uploads)
# Local: docker compose up redis -d  →  redis://127.0.0.1:6379
# Compose stack sets redis://redis:6379 automatically
REDIS_URL=redis://127.0.0.1:6379

# Shared blob root for uploads + results (web and worker must match)
# Docker compose uses /data; local default is ./.data
# DATA_DIR=.data

# Worker parallelism (default 1 — raise only if the host has spare RAM)
# ANALYZE_CONCURRENCY=1

# Job status / result TTL (ms, default 1 hour)
# ANALYZE_JOB_TTL_MS=3600000

# Optional: larger upload chunks after raising nginx client_max_body_size
# NEXT_PUBLIC_UPLOAD_CHUNK_KB=4096
